{
  "openapi": "3.1.0",
  "info": {
    "title": "Staff Commission Quote API",
    "version": "1.0.0",
    "description": "Staff API for commission quotes. commissionRate is a percentage with 5 fractional digits. AUD totalCommission has 9 fractional digits."
  },
  "components": {
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/v1/quotes": {
      "post": {
        "operationId": "createQuote",
        "summary": "Create a commission quote",
        "tags": [
          "Quotes"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "currency": {
                    "type": "string",
                    "enum": [
                      "AUD"
                    ],
                    "description": "ISO 4217 currency. Version 1 allows AUD only. There is no default.",
                    "examples": [
                      "AUD"
                    ]
                  },
                  "loanAmount": {
                    "type": "string",
                    "description": "Canonical decimal whose scale is the currency exponent. AUD uses exactly 2 fractional digits, from 0.01 to 10000000.00.",
                    "examples": [
                      "10000.00"
                    ]
                  },
                  "loanTermInMonths": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 360,
                    "description": "Whole months from 1 to 360.",
                    "examples": [
                      360
                    ]
                  },
                  "riskBand": {
                    "type": "string",
                    "enum": [
                      "LOW",
                      "MEDIUM",
                      "HIGH"
                    ],
                    "description": "Case-sensitive risk band.",
                    "examples": [
                      "HIGH"
                    ]
                  }
                },
                "required": [
                  "currency",
                  "loanAmount",
                  "loanTermInMonths",
                  "riskBand"
                ],
                "additionalProperties": false,
                "description": "Loan details for a commission quote. Every field is required."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Commission quote",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "quoteId": {
                      "type": "string",
                      "format": "uuid",
                      "description": "Identifier for this quote.",
                      "examples": [
                        "8d3c1c2e-6f0a-4d1b-9c2e-0a1b2c3d4e5f"
                      ]
                    },
                    "currency": {
                      "type": "string",
                      "enum": [
                        "AUD"
                      ],
                      "description": "ISO 4217 currency. Version 1 allows AUD only. There is no default.",
                      "examples": [
                        "AUD"
                      ]
                    },
                    "commissionRate": {
                      "type": "string",
                      "description": "Percentage with exactly 5 fractional digits. 1.50000 means 1.5 percent, not the fraction 0.015.",
                      "examples": [
                        "1.50000"
                      ]
                    },
                    "totalCommission": {
                      "type": "string",
                      "description": "Exact commission. Scale is the currency exponent plus 7. AUD uses exactly 9 fractional digits. 10000.00 at 1.50000 percent is 150.000000000.",
                      "examples": [
                        "150.000000000"
                      ]
                    }
                  },
                  "required": [
                    "quoteId",
                    "currency",
                    "commissionRate",
                    "totalCommission"
                  ],
                  "additionalProperties": false,
                  "description": "Commission quote. Every field is required."
                }
              }
            }
          },
          "400": {
            "description": "The request is not valid",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "invalid_request",
                        "unauthorized",
                        "forbidden",
                        "not_found",
                        "rate_limited",
                        "service_unavailable",
                        "vendor_unavailable",
                        "vendor_timeout",
                        "internal_error"
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "details": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "field": {
                            "type": "string"
                          },
                          "code": {
                            "type": "string",
                            "enum": [
                              "invalid_amount",
                              "invalid_term",
                              "invalid_risk_band",
                              "invalid_currency",
                              "invalid_rate",
                              "invalid_commission",
                              "invalid_quote_id",
                              "unknown_field",
                              "missing_body",
                              "missing_field"
                            ]
                          },
                          "params": {
                            "type": "object",
                            "additionalProperties": {
                              "anyOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "number"
                                }
                              ]
                            }
                          }
                        },
                        "required": [
                          "code"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
