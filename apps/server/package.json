{
  "name": "@quote/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./vendor-fetch": "./src/vendor-fetch.ts"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx src/server.ts",
    "start": "NODE_ENV=production tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "openapi:write": "tsx src/openapi-check.ts --write",
    "openapi:check": "tsx src/openapi-check.ts",
    "ci": "yarn typecheck && yarn lint && yarn test && yarn openapi:check"
  },
  "dependencies": {
    "@hono/node-server": "1.19.6",
    "@hono/zod-openapi": "1.1.5",
    "@quote/contract": "workspace:*",
    "@scalar/hono-api-reference": "0.9.35",
    "hono": "4.10.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.0",
    "@types/node": "24.9.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
