# Development values. They must match env/dev.json.
# Three roles: web server 5173, internal API 4000, external API 3010.
# Production is env/production.json: internal API and web server share HTTPS 4443,
# and the external API is HTTPS 3443. The external port is always 3000-3999.
MOCK_API_PORT=3010
SERVER_PORT=4000
MOCK_API_BASE_URL=http://127.0.0.1:3010
MOCK_API_KEY=dev-key
FAILURE_RATE=0.15
WEB_PORT=5173
